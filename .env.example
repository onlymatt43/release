# Copy to .env.local for development, or set as project environment
# variables in your deployment platform. Every value below is read from the
# environment only — there is no operator baked into the code, so the same
# codebase serves any deployment by configuration alone.

# ── Database (required) ────────────────────────────────────────────────────
# Turso / libSQL connection.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── File storage (required) ────────────────────────────────────────────────
# Cloudflare R2 (S3-compatible) bucket used for ID photos and signatures.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Admin access (required) ────────────────────────────────────────────────
# Shared secret checked against the admin session cookie by middleware.ts.
ADMIN_SECRET=

# ── Site identity (optional) ───────────────────────────────────────────────
# Unset values are omitted from page metadata and legal pages rather than
# replaced by a placeholder — see lib/site-config.ts.
SITE_BRAND_NAME=
SITE_DESCRIPTION=
SITE_URL=
# BCP-47 tag (e.g. en-US, fr-CA) used to format dates on consent documents.
# Unset falls back to the runtime's own default locale.
SITE_LOCALE=
# IANA time zone (e.g. America/Toronto) used to format signature timestamps.
# Unset falls back to the runtime's own time zone.
SITE_TIMEZONE=
SITE_OPERATOR_NAME=
SITE_CONTACT_EMAIL=
SITE_OG_IMAGE_URL=
SITE_FAVICON_BASE_URL=
# Comma-separated platform names named in the consent form's legal text and
# publication-consent checkbox (e.g. "OnlyFans, Fansly"). Unset describes
# platforms generically instead of naming any.
SITE_PLATFORM_EXAMPLES=

# ── Optional integrations ──────────────────────────────────────────────────
# Address autocomplete on the consent form (Google Places API).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Webhook notified (HTTP PUT) when a consent form is signed, with the shoot
# id appended to the URL. Leave unset to disable the notification entirely.
CONSENT_WEBHOOK_URL=

# ── Transport flow (/app) ──────────────────────────────────────────────────
# See docs/INTEGRATION.md. Identity and profiles come from an external
# provider; release keeps no accounts and deletes agreements after delivery.

# Secret signing the visitor session cookie (any long random string).
SESSION_SECRET=
# Session lifetime in hours (default 24).
SESSION_TTL_HOURS=

# Identity provider. Only "http-jwt" exists today (default).
IDENTITY_PROVIDER=
# Label shown on the sign-in prompt.
IDENTITY_PROVIDER_NAME=
# Where a visitor without a session is sent; ?return_to= is appended.
IDENTITY_LOGIN_URL=
# Where a signer without a profile on file is sent to fill it in;
# ?return_to= is appended and the provider sends them back there when done.
IDENTITY_PROFILE_SETUP_URL=
# HS256 secret the provider signs entry tokens with (see /app/enter).
IDENTITY_JWT_SECRET=
# Optional expected "iss" / "aud" claims.
IDENTITY_JWT_ISSUER=
IDENTITY_JWT_AUDIENCE=
# Profile endpoint; {id} and {handle} are replaced by the subject's values.
IDENTITY_PROFILE_URL=
# Optional handle lookup ({handle} replaced) returning {id, handle, ...} or
# 404. When set, an invitation binds to the account, not to the handle.
IDENTITY_RESOLVE_URL=
# Bearer sent to the provider endpoints and to image URLs on its origin.
IDENTITY_SHARED_SECRET=
# Extra origins (comma-separated) profile image URLs may point to. The
# provider's own origin is always allowed; every other URL is refused.
IDENTITY_IMAGE_ORIGINS=
# Largest profile image accepted, in bytes (default 5242880 = 5 MB).
PROFILE_IMAGE_MAX_BYTES=

# Contract text (JSON): a URL fetched at agreement creation, or inline.
# Shape in config/contract.example.json. One of the two is required.
CONTRACT_URL=
CONTRACT_JSON=

# Days before an undelivered agreement is purged (default 7).
AGREEMENT_TTL_DAYS=
# Most agreements one account may have in transit at once (default 10).
AGREEMENT_MAX_IN_TRANSIT=
# Minutes a fully delivered agreement lingers so a broken download can be
# retried (default 0: deleted the moment everyone has downloaded).
AGREEMENT_DELIVERY_GRACE_MINUTES=
# Bearer the scheduled purge (vercel.json) authenticates with.
CRON_SECRET=
